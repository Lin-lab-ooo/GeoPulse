{
  "schema": "geo-pulse/whole-map-benchmark-policy-1.0",
  "protocol": "docs/WHOLE-MAP-BENCHMARK-PROTOCOL.md",
  "defaultScope": "whole-map-with-stage-timings",
  "clockBasis": "performance.timeOrigin+performance.now()",
  "phaseStatusValues": [
    "measured",
    "not-applicable",
    "unavailable",
    "invalid"
  ],
  "requiredPhaseGroups": [
    "map-initialization",
    "base-resource-network",
    "stream-fetch-headers",
    "stream-first-byte",
    "stream-transport-resource",
    "stream-read-wait",
    "stream-reader-eof",
    "stream-decode",
    "stream-parse",
    "pack",
    "worker-post-message",
    "worker-main-delivery",
    "staging",
    "staging-commit-wait",
    "geometry-upload-submission",
    "index-upload-submission",
    "spatial-build",
    "spatial-query-main",
    "spatial-query-worker",
    "live-bounds-maintenance",
    "source-adapter",
    "source-update-submission",
    "source-processing",
    "whole-map-render-cpu",
    "business-render-cpu",
    "whole-map-gpu",
    "compositor-frame-cadence",
    "raf-callback-cadence",
    "end-to-end-ready",
    "report-export"
  ],
  "requiredIdentity": [
    "sourceBefore",
    "sourceAfter",
    "runtimeBefore",
    "runtimeAfter",
    "toolSHA256",
    "observerSHA256",
    "servedModuleSHA256",
    "libraryVersions",
    "librarySHA256",
    "fixtureSHA256",
    "manifestSHA256"
  ],
  "requiredPerBatchFields": [
    "runId",
    "batchId",
    "featureCount",
    "vertexCount",
    "postEpochMs",
    "receiveEpochMs",
    "lastStagingRevision",
    "commitConfirmedEpochMs",
    "ackSendEpochMs",
    "ackReceiveEpochMs"
  ],
  "requiredWholeMapFrameFields": [
    "runId",
    "frameId",
    "startEpochMs",
    "endEpochMs",
    "renderCpuMs",
    "gpuMs",
    "gpuStatus",
    "businessRevision",
    "camera"
  ],
  "rules": {
    "predeclareManifest": true,
    "serialGpuExecution": true,
    "sourceMustRemainStable": true,
    "refuseReportOverwrite": true,
    "preserveFailedAndPartialRuns": true,
    "bindActualServedInstrumentation": true,
    "commonBaseMapAcrossVariants": true,
    "qualityGateBeforePerformance": true,
    "separatePointSubsetAndMixedProduction": true,
    "separateColdAndCachedRuns": true,
    "separateNaturalSchedulingAndFixedRepaint": true,
    "noPhaseSumAsWallElapsed": true,
    "noNestedCpuDoubleCounting": true,
    "noNestedTimeElapsedGpuQueries": true,
    "noAckAsGpuCompletion": true,
    "noReaderEofAsWireCompletion": true,
    "noRafAsPresentationFps": true,
    "noBusinessGpuAsWholeMapGpu": true,
    "noRenderCpuAsTotalBrowserCpu": true,
    "noDerivedCpuOrGpuUtilization": true,
    "unavailableRequiresReasonAndScope": true,
    "unsupportedMetricsRemainNull": true
  },
  "reportVerdicts": [
    "wholeMapExecution",
    "phaseCoverage",
    "qualityPassed",
    "timingValid",
    "comparisonScope"
  ]
}